@model ECommerceManagementSystem.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom p-4 border-danger">
            <h3 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Product</h3>
            <p>Are you sure you want to permanently delete this product?</p>

            <div class="d-flex align-items-center mb-3">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/80" : Model.ImageUrl)" style="width: 80px; height: 80px; object-fit: cover;" class="rounded border me-3" />
                <div>
                    <h5 class="fw-bold m-0">@Model.Name</h5>
                    <span class="text-muted">Category: @(Model.Category?.Name ?? "Unassigned")</span>
                    <div class="fw-bold text-success">$@Model.Price.ToString("F2")</div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>