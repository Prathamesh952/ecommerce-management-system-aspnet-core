@model IEnumerable<ECommerceManagementSystem.Models.Wishlist>
@{
    ViewData["Title"] = "My Wishlist";
}

<h2 class="fw-bold mb-4"><i class="bi bi-heart-fill text-danger me-2"></i>My Saved Wishlist</h2>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card card-custom h-100">
                    <img src="@(string.IsNullOrEmpty(item.Product?.ImageUrl) ? "https://via.placeholder.com/300" : item.Product.ImageUrl)" class="card-img-top p-2" style="height: 180px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <small class="text-muted mb-1">@(item.Product?.Category?.Name ?? "General")</small>
                        <h6 class="card-title fw-bold text-truncate">@item.Product?.Name</h6>
                        <span class="fs-5 fw-bold text-success mb-3">$@item.Product?.Price.ToString("F2")</span>

                        <div class="mt-auto d-flex gap-2">
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary flex-fill">View</a>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-heartbreak display-3 text-muted mb-3 d-block"></i>
        <h4>Your wishlist is empty.</h4>
        <p class="text-muted">Save your favorite products for later!</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2"><i class="bi bi-shop me-1"></i> Browse Products</a>
    </div>
}
