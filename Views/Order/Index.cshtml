@model IEnumerable<ECommerceManagementSystem.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<h2 class="fw-bold mb-4"><i class="bi bi-bag-check text-primary me-2"></i>My Order History</h2>

@if (Model != null && Model.Any())
{
    <div class="card card-custom p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Total Amount</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <span class="badge bg-info text-dark">@order.Status</span>
                            </td>
                            <td class="fw-bold text-success">$@order.TotalAmount.ToString("F2")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info me-1"><i class="bi bi-eye"></i> Details</a>
                                <a asp-action="Invoice" asp-route-id="@order.Id" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-printer"></i> Invoice</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-receipt display-3 text-muted mb-3 d-block"></i>
        <h4>You haven't placed any orders yet.</h4>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2"><i class="bi bi-shop me-1"></i> Start Shopping</a>
    </div>
}
