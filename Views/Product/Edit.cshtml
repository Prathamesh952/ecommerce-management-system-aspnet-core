@model ECommerceManagementSystem.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card card-custom p-4">
            <h3 class="fw-bold mb-3"><i class="bi bi-pencil-square text-warning me-2"></i>Edit Product</h3>
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label font-weight-semibold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label font-weight-semibold">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label font-weight-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label font-weight-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label font-weight-semibold"></label>
                        <input asp-for="Stock" class="form-control" type="number" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-semibold">Current Cover Image</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" style="max-height: 120px;" class="rounded border" />
                        </div>
                    }
                    <input type="file" name="primaryImage" class="form-control" accept="image/*" />
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-semibold">Add Additional Gallery Images</label>
                    <input type="file" name="galleryImages" class="form-control" accept="image/*" multiple />
                </div>

                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Existing Gallery Images</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var img in Model.Images)
                            {
                                <div class="position-relative border p-1 rounded">
                                    <img src="@img.ImageUrl" style="width: 80px; height: 80px; object-fit: cover;" class="rounded" />
                                    <form asp-action="DeleteImage" method="post" class="d-inline">
                                        <input type="hidden" name="imageId" value="@img.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 px-1 py-0"><i class="bi bi-x"></i></button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="mb-3 form-check">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label font-weight-semibold">Featured Product</label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                    <button type="submit" class="btn btn-warning px-4"><i class="bi bi-check-circle me-1"></i> Update Product</button>
                </div>
            </form>
        </div>
    </div>
</div>