@using Microsoft.AspNetCore.Identity
@using ECommerceManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    <li class="nav-item me-2">
        <a class="nav-link text-light font-weight-bold" asp-controller="Wishlist" asp-action="Index">
            <i class="bi bi-heart-fill text-danger me-1"></i> Wishlist
        </a>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle btn btn-outline-light text-white px-3 py-1 me-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle me-1"></i> Hi, @(currentUser?.FullName ?? User.Identity?.Name)
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
            @if (User.IsInRole("Admin"))
            {
                <li><a class="dropdown-item fw-bold text-primary" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                <li><a class="dropdown-item" asp-controller="Category" asp-action="Index"><i class="bi bi-tags me-2"></i>Manage Categories</a></li>
                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Manage Products</a></li>
                <li><a class="dropdown-item" asp-controller="Order" asp-action="AdminOrders"><i class="bi bi-receipt me-2"></i>Manage Orders</a></li>
                <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart me-2"></i>Sales Analytics</a></li>
                <li><hr class="dropdown-divider"></li>
            }
            <li><a class="dropdown-item" asp-controller="Order" asp-action="Index"><i class="bi bi-bag-check me-2"></i>My Orders</a></li>
            <li>
                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white me-2" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i> Register
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Login
        </a>
    </li>
}
</ul>
