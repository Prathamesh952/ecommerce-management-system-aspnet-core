@model ECommerceManagementSystem.Models.Product
@{
    ViewData["Title"] = "Product Details - " + Model.Name;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card card-custom p-4">
            <div class="row">
                <div class="col-md-5">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/400" : Model.ImageUrl)" class="img-fluid rounded border shadow-sm w-100 mb-3" alt="@Model.Name" />
                    
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        <h6 class="fw-bold mt-2">Gallery</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var img in Model.Images)
                            {
                                <img src="@img.ImageUrl" style="width: 70px; height: 70px; object-fit: cover;" class="rounded border" />
                            }
                        </div>
                    }
                </div>

                <div class="col-md-7">
                    <span class="badge bg-primary mb-2">@(Model.Category?.Name ?? "Unassigned")</span>
                    <h2 class="fw-bold mb-2">@Model.Name</h2>
                    <h3 class="text-success fw-bold mb-3">$@Model.Price.ToString("F2")</h3>

                    <p class="text-muted mb-4">@Model.Description</p>

                    <div class="mb-3">
                        <strong>Availability:</strong>
                        @if (Model.Stock > 0)
                        {
                            <span class="badge bg-success">In Stock (@Model.Stock available)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Out of Stock</span>
                        }
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit Product</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Catalog</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>