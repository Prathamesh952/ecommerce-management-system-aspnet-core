@model IEnumerable<ECommerceManagementSystem.Models.Order>
@{
    ViewData["Title"] = "Manage Customer Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0"><i class="bi bi-receipt text-primary me-2"></i>Order Management</h2>
        <p class="text-muted m-0">View all customer orders and update status.</p>
    </div>
</div>

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Current Status</th>
                    <th class="text-end">Update Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-bold">#@order.Id</td>
                        <td>@order.CustomerName <br /><small class="text-muted">@order.User?.Email</small></td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="fw-bold text-success">$@order.TotalAmount.ToString("F2")</td>
                        <td>
                            <span class="badge bg-warning text-dark">@order.Status</span>
                        </td>
                        <td class="text-end">
                            <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <select name="status" class="form-select form-select-sm" style="width: auto;">
                                    @foreach (var st in Enum.GetValues<ECommerceManagementSystem.Models.OrderStatus>())
                                    {
                                        <option value="@st" selected="@(order.Status == st ? "selected" : null)">@st</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg"></i></button>
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
