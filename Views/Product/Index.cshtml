@model ECommerceManagementSystem.Models.PaginatedList<ECommerceManagementSystem.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0"><i class="bi bi-box-seam text-primary me-2"></i>Products Catalog</h2>
        <p class="text-muted m-0">Manage product inventory, images, prices, and categories.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Product</a>
</div>

<!-- Admin Search & Filter Bar -->
<div class="card card-custom p-3 mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Search by name or description..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- All Categories --</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-search"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
        </div>
    </form>
</div>

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Featured</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/60" : item.ImageUrl)" style="width: 50px; height: 50px; object-fit: cover;" class="rounded border" alt="@item.Name" />
                        </td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>
                            <span class="badge bg-info text-dark">@(item.Category?.Name ?? "Unassigned")</span>
                        </td>
                        <td class="fw-bold text-success">$@item.Price.ToString("F2")</td>
                        <td>
                            @if (item.Stock > 5)
                            {
                                <span class="badge bg-success">@item.Stock in stock</span>
                            }
                            else if (item.Stock > 0)
                            {
                                <span class="badge bg-warning text-dark">Low Stock (@item.Stock)</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                        </td>
                        <td>
                            @if (item.IsFeatured)
                            {
                                <span class="badge bg-primary"><i class="bi bi-star-fill me-1"></i> Featured</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">No products found matching your search.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model != null && Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            <div>
                Showing page <strong>@Model.PageIndex</strong> of <strong>@Model.TotalPages</strong>
            </div>
            <ul class="pagination mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-searchString="@ViewBag.SearchString"><i class="bi bi-chevron-left"></i> Previous</a>
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-searchString="@ViewBag.SearchString">Next <i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </div>
    }
</div>