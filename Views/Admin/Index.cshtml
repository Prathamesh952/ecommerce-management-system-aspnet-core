@model ECommerceManagementSystem.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0"><i class="bi bi-speedometer2 text-primary me-2"></i>Executive Dashboard</h2>
        <p class="text-muted m-0">Real-time telemetry and overview of your enterprise store performance.</p>
    </div>
</div>

<!-- Metric Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-gradient-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 mb-1">Total Revenue</h6>
                    <h3 class="fw-bold m-0">$@Model.TotalRevenue.ToString("N2")</h3>
                </div>
                <i class="bi bi-currency-dollar display-5 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-success text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 mb-1">Total Orders</h6>
                    <h3 class="fw-bold m-0">@Model.TotalOrders</h3>
                </div>
                <i class="bi bi-cart-check display-5 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-warning text-dark">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-dark-50 mb-1">Active Products</h6>
                    <h3 class="fw-bold m-0">@Model.TotalProducts</h3>
                </div>
                <i class="bi bi-box-seam display-5 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-info text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 mb-1">Categories</h6>
                    <h3 class="fw-bold m-0">@Model.TotalCategories</h3>
                </div>
                <i class="bi bi-tags display-5 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Graph -->
<div class="row mb-4">
    <div class="col-lg-8">
        <div class="card card-custom p-4 h-100">
            <h5 class="fw-bold mb-3"><i class="bi bi-pie-chart text-primary me-2"></i>Product Distribution per Category</h5>
            <canvas id="categoryChart" style="max-height: 280px;"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-custom p-4 h-100 bg-light">
            <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge text-warning me-2"></i>Quick Actions</h5>
            <div class="d-grid gap-2">
                <a asp-controller="Product" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Create New Product</a>
                <a asp-controller="Category" asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-folder-plus me-1"></i> Add Category</a>
                <a asp-controller="Order" asp-action="AdminOrders" class="btn btn-outline-success"><i class="bi bi-receipt me-1"></i> View All Customer Orders</a>
                <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-dark"><i class="bi bi-bar-chart me-1"></i> Generate Business Reports</a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Tables -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-primary me-2"></i>Recently Added Products</h5>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prod in Model.RecentProducts)
                        {
                            <tr>
                                <td class="fw-semibold">@prod.Name</td>
                                <td><span class="badge bg-secondary">@(prod.Category?.Name ?? "General")</span></td>
                                <td class="fw-bold text-success">$@prod.Price.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-bag-check text-success me-2"></i>Recent Customer Orders</h5>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in Model.RecentOrders)
                        {
                            <tr>
                                <td class="fw-bold">#@ord.Id</td>
                                <td>@ord.CustomerName</td>
                                <td class="fw-bold text-success">$@ord.TotalAmount.ToString("F2")</td>
                                <td><span class="badge bg-warning text-dark">@ord.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('categoryChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Json.Serialize(Model.CategoryNames),
                datasets: [{
                    label: 'Number of Products',
                    data: @Json.Serialize(Model.CategoryProductCounts),
                    backgroundColor: 'rgba(13, 110, 253, 0.7)',
                    borderColor: 'rgba(13, 110, 253, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}
