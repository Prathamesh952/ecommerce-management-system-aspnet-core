@model ECommerceManagementSystem.Models.ViewModels.ReportViewModel
@{
    ViewData["Title"] = "Business Reports & Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0"><i class="bi bi-graph-up text-primary me-2"></i>Sales & Revenue Reports</h2>
        <p class="text-muted m-0">Detailed analytical breakdowns of business revenue and product performance.</p>
    </div>
    <a asp-action="ExportCsv" class="btn btn-success"><i class="bi bi-file-earmark-excel me-1"></i> Export Sales CSV</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-calendar3 text-primary me-2"></i>Monthly Sales Summary</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Month</th>
                            <th>Total Orders</th>
                            <th>Total Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MonthlySales)
                        {
                            <tr>
                                <td class="fw-bold">@m.Month</td>
                                <td>@m.TotalOrders</td>
                                <td class="fw-bold text-success">$@m.TotalRevenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-trophy text-warning me-2"></i>Top Selling Products</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Product Name</th>
                            <th>Qty Sold</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.TopProducts)
                        {
                            <tr>
                                <td class="fw-semibold">@p.ProductName</td>
                                <td><span class="badge bg-info text-dark">@p.TotalQuantitySold</span></td>
                                <td class="fw-bold text-success">$@p.TotalRevenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
