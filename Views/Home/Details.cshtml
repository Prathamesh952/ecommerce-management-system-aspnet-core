@model ECommerceManagementSystem.Models.Product
@{
    ViewData["Title"] = Model.Name + " - Details";
}

<div class="row g-4 mb-5">
    <!-- Image Gallery -->
    <div class="col-md-6">
        <div class="card card-custom p-3 text-center">
            <img id="mainProductImg" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/500" : Model.ImageUrl)" class="img-fluid rounded border shadow-sm mb-3" style="max-height: 380px; object-fit: contain;" />
            
            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="d-flex justify-content-center gap-2">
                    <img src="@Model.ImageUrl" style="width: 60px; height: 60px; object-fit: cover; cursor: pointer;" class="rounded border active-img" onclick="document.getElementById('mainProductImg').src=this.src;" />
                    @foreach (var img in Model.Images)
                    {
                        <img src="@img.ImageUrl" style="width: 60px; height: 60px; object-fit: cover; cursor: pointer;" class="rounded border" onclick="document.getElementById('mainProductImg').src=this.src;" />
                    }
                </div>
            }
        </div>
    </div>

    <!-- Product Info & Purchase Form -->
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <span class="badge bg-primary mb-2 w-25">@(Model.Category?.Name ?? "General")</span>
            <h2 class="fw-bold">@Model.Name</h2>
            
            <div class="d-flex align-items-center mb-3">
                <span class="fs-2 fw-bold text-success me-3">$@Model.Price.ToString("F2")</span>
                <span class="badge @(Model.Stock > 0 ? "bg-success" : "bg-danger") fs-6">
                    @(Model.Stock > 0 ? $"In Stock ({Model.Stock})" : "Out of Stock")
                </span>
            </div>

            <p class="text-muted mb-4">@Model.Description</p>

            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-3">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="row g-2 align-items-center">
                    <div class="col-auto">
                        <label class="col-form-label font-weight-semibold">Quantity:</label>
                    </div>
                    <div class="col-3">
                        <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" />
                    </div>
                    <div class="col">
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" @(Model.Stock <= 0 ? "disabled" : "")><i class="bi bi-cart-plus me-1"></i> Add to Cart</button>
                    </div>
                </div>
            </form>

            <form asp-controller="Wishlist" asp-action="ToggleWishlist" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger w-100 py-2"><i class="bi bi-heart me-1"></i> Save to Wishlist</button>
            </form>
        </div>
    </div>
</div>

<!-- Product Reviews Section -->
<div class="row">
    <div class="col-12">
        <div class="card card-custom p-4">
            <h4 class="fw-bold mb-4"><i class="bi bi-chat-left-text text-primary me-2"></i>Customer Reviews (@(Model.Reviews?.Count ?? 0))</h4>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="bg-light p-3 rounded mb-4 border">
                    <h6 class="fw-bold mb-2">Leave a Review</h6>
                    <form asp-action="AddReview" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label">Rating</label>
                                <select name="rating" class="form-select">
                                    <option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
                                    <option value="4">⭐⭐⭐⭐ (4/5)</option>
                                    <option value="3">⭐⭐⭐ (3/5)</option>
                                    <option value="2">⭐⭐ (2/5)</option>
                                    <option value="1">⭐ (1/5)</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <textarea name="comment" class="form-control" rows="2" placeholder="Write your feedback..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-send me-1"></i> Submit Review</button>
                    </form>
                </div>
            }
            else
            {
                <div class="alert alert-secondary mb-4">Please <a asp-controller="Account" asp-action="Login">log in</a> to write a product review.</div>
            }

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var rev in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold">@(rev.User?.FullName ?? "Verified Customer")</span>
                                <small class="text-muted">@rev.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </div>
                            <div class="text-warning mb-2">
                                @for (int i = 0; i < rev.Rating; i++) { <i class="bi bi-star-fill"></i> }
                            </div>
                            <p class="mb-0 text-secondary">@rev.Comment</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted m-0">No reviews yet for this product. Be the first to review!</p>
            }
        </div>
    </div>
</div>
