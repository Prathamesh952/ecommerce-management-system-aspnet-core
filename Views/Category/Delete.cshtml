@model ECommerceManagementSystem.Models.Category
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom p-4 border-danger">
            <h3 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Category</h3>
            <p>Are you sure you want to delete this category?</p>
            
            <dl class="row">
                <dt class="col-sm-4">Category Name</dt>
                <dd class="col-sm-8 fw-bold">@Model.Name</dd>
                <dt class="col-sm-4">Linked Products</dt>
                <dd class="col-sm-8">@Model.Products.Count products</dd>
            </dl>

            @if (Model.Products.Any())
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-info-circle-fill me-1"></i> Warning: This category has <strong>@Model.Products.Count</strong> linked products. Deletion will be blocked by system validation.
                </div>
            }

            <form asp-action="Delete" method="post" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                    <button type="submit" class="btn btn-danger" @(Model.Products.Any() ? "disabled" : "")><i class="bi bi-trash"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>
