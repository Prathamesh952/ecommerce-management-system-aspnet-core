@model ECommerceManagementSystem.Models.Order
@{
    ViewData["Title"] = "Order Details #" + Model.Id;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-file-text text-primary me-2"></i>Order Details #@Model.Id</h2>
    <a asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-primary"><i class="bi bi-printer me-1"></i> Print Invoice</a>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3">Order Items</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td class="fw-semibold">@(item.Product?.Name ?? "Product #" + item.ProductId)</td>
                                <td>$@item.UnitPrice.ToString("F2")</td>
                                <td>@item.Quantity</td>
                                <td class="text-end fw-bold">$@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3">Delivery Information</h5>
            <p class="mb-1"><strong>Customer:</strong> @Model.CustomerName</p>
            <p class="mb-1"><strong>Address:</strong> @Model.ShippingAddress</p>
            <p class="mb-1"><strong>City/Postal:</strong> @Model.City, @Model.PostalCode</p>
            <p class="mb-1"><strong>Payment:</strong> @Model.PaymentMethod</p>
            <p class="mb-3"><strong>Order Status:</strong> <span class="badge bg-warning text-dark">@Model.Status</span></p>

            <hr />
            <div class="d-flex justify-content-between fs-5 fw-bold">
                <span>Total Amount:</span>
                <span class="text-success">$@Model.TotalAmount.ToString("F2")</span>
            </div>
        </div>
    </div>
</div>
